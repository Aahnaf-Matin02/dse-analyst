{
  "name": "dse-ai-analyst",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "clean": "rm -rf dist build server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "import:history": "tsx scripts/import-dse-history.ts",
    "import:investing-history": "tsx scripts/import-investing-history.ts",
    "import:one-year-history": "tsx scripts/import-one-year-history.ts",
    "checklist": "tsx scripts/generateDownloadChecklist.ts",
    "seed:stocks": "tsx scripts/seedAllDseStocks.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@netlify/blobs": "^11.1.3",
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
