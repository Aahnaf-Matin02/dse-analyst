# Required Netlify deployment and backend configuration env variables

# your_gemini_api_key_here (Never expose to client-side frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini foundation model
GEMINI_MODEL=gemini-3.8-flash

# Node.js platform version
NODE_VERSION=20

# Port to bind the Express local server (For local container running)
PORT=3000

# Local filesystem fallback paths (for simulation data, bypassed or ephemeral in serverless environments)
DATA_PATH="./data/DSE_COMPANIES.json"
USERS_DB_PATH="./data/users_db.json"
SESSIONS_DB_PATH="./data/sessions_db.json"

# DSE scraper settings
DSE_BASE_URL=https://dse.com.bd
DSE_LATEST_PRICE_PATH=/latest_share_price_all.php
DSE_COMPANY_PATH=/company/{symbol}

# Optional Transactional Email Configuration (SMTP)
# Fallback is server/console logging of verification OTPs and reset URLs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dse-ai-analyst.com
APP_URL=http://localhost:3000


